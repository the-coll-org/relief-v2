# syntax=docker/dockerfile:1
# ---- Relief Network refresh sidecar (Node + Python) -------------------------
# Owns the database lifecycle on the shared /data volume:
#   1. prisma db push   — ensure schema exists
#   2. seed-if-empty    — load hotlines + initial providers from the snapshot
#   3. scheduler.mjs    — scrape PowerBI + upsert providers every 6h
# Needs Node (Prisma ingest) and Python (the PowerBI scraper).
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-venv git ca-certificates openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package*.json ./
# Schema must exist before `npm ci` — the postinstall hook runs `prisma generate`.
COPY prisma ./prisma
RUN npm ci
COPY . .
ENV DATABASE_URL=file:/data/relief.db \
    SCRAPER_DIR=/scraper \
    APP_DIR=/app \
    NPM=npm
RUN npx prisma generate
# Scraper repo pinned to an explicit commit (auditable, reproducible — never a
# moving HEAD). Public repo, no credentials needed. Bump SCRAPER_REF to update.
ARG SCRAPER_REF=770727e53ec7dbc001881ad8eda3d1f3a92415f5
RUN git clone https://github.com/the-coll-org/lbresponse-scrapper /scraper \
 && git -C /scraper checkout "${SCRAPER_REF}" \
 && python3 -m venv /scraper/.venv \
 && /scraper/.venv/bin/pip install --no-cache-dir -r /scraper/requirements.txt Pillow
COPY docker/refresh-entrypoint.sh /usr/local/bin/refresh-entrypoint.sh
RUN chmod +x /usr/local/bin/refresh-entrypoint.sh
VOLUME /data
CMD ["/usr/local/bin/refresh-entrypoint.sh"]
